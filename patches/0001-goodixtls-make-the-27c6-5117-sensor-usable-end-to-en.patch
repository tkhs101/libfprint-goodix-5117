diff --git a/libfprint/drivers/goodixtls/goodix511.c b/libfprint/drivers/goodixtls/goodix511.c
index d990ae1..21473ef 100644
--- a/libfprint/drivers/goodixtls/goodix511.c
+++ b/libfprint/drivers/goodixtls/goodix511.c
@@ -206,13 +206,38 @@ activate_run_state (FpiSsm *ssm, FpDevice *dev)
     }
 }
 
+static void activate_complete (FpiSsm *ssm, FpDevice *dev, GError *error);
+
+/* LOCAL PATCH: on GF_ST411SEC_APP_12118 hardware the sensor boots straight
+ * into its TLS transport and only answers 0xae (query MCU state) and 0xd0
+ * (request TLS connection) in clear text. Everything else - enable_chip,
+ * firmware query, PSK read, reset, config upload - times out until the TLS
+ * session is up, so the stock order (activate commands, then TLS) can never
+ * complete. Bring the TLS session up first and run the activation sequence
+ * afterwards. */
+static void
+activate_after_tls (FpDevice *dev, gpointer user_data, GError *error)
+{
+  if (error)
+    {
+      fp_err ("failed to bring up TLS before activation: %s", error->message);
+      fpi_image_device_activate_complete (FP_IMAGE_DEVICE (dev), error);
+      return;
+    }
+
+  fp_dbg ("TLS established before activation, running activate sequence");
+  fpi_ssm_start (fpi_ssm_new (dev, activate_run_state, ACTIVATE_NUM_STATES),
+                 activate_complete);
+}
+
 static void
 activate_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
 {
   G_DEBUG_HERE ();
   if (!error)
     {
-      goodixtls5xx_init_tls (dev);
+      /* TLS is already up (see activate_after_tls), so activation is done. */
+      fpi_image_device_activate_complete (FP_IMAGE_DEVICE (dev), NULL);
     }
   else
     {
@@ -228,20 +253,45 @@ activate_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
 
 // ---- SCAN SECTION START ----
 
+/* LOCAL PATCH: every FDT command needs its own register sequence, and each
+ * carries a leading length byte. The stock driver reused a single table (with
+ * no length byte and different values) for 0x32/0x34/0x36, so the sensor never
+ * entered a mode where MCU_GET_IMAGE (0x20) returns a frame. Values below are
+ * taken from the Goodix reference driver (goodix-fp-dump, driver_51x7.py) for
+ * GF_ST411SEC_APP_121xx parts. */
 const guint8 fdt_switch_state_mode[] = {
+  0x0d,
   0x01,
-  0x80,
-  0xaf,
-  0x80,
-  0xbf,
-  0x80,
-  0xa4,
-  0x80,
-  0xb8,
-  0x80,
-  0xa8,
-  0x80,
-  0xb7,
+  0x80, 0xb0,
+  0x80, 0xc0,
+  0x80, 0xa4,
+  0x80, 0xb4,
+  0x80, 0xa3,
+  0x80, 0xb4,
+};
+
+/* 0x34 mcu_switch_to_fdt_up */
+const guint8 fdt_up_mode[] = {
+  0x0e,
+  0x01,
+  0x80, 0x90,
+  0x80, 0x9a,
+  0x80, 0x7b,
+  0x80, 0x95,
+  0x80, 0x8c,
+  0x80, 0xa3,
+};
+
+/* 0x32 mcu_switch_to_fdt_down (armed for capture, waits for the finger) */
+const guint8 fdt_down_mode[] = {
+  0x0c,
+  0x01,
+  0x80, 0xb2,
+  0x80, 0xc2,
+  0x80, 0xa7,
+  0x80, 0xb6,
+  0x80, 0xa6,
+  0x80, 0xb6,
 };
 
 
@@ -254,8 +304,13 @@ dev_activate (FpImageDevice *img_dev)
 {
   FpDevice *dev = FP_DEVICE (img_dev);
 
-  fpi_ssm_start (fpi_ssm_new (dev, activate_run_state, ACTIVATE_NUM_STATES),
-                 activate_complete);
+  /* LOCAL PATCH: this firmware family needs the TLS session before it will
+   * accept any clear-text command other than 0xae/0xd0.
+   * The USB read loop is normally started by ACTIVATE_READ_AND_NOP, which now
+   * runs after the handshake, so start it here first - otherwise the device's
+   * TLS records are never picked up and the handshake stalls forever. */
+  goodix_start_read_loop (dev);
+  goodix_tls_init (dev, activate_after_tls, NULL);
 }
 
 
@@ -276,6 +331,39 @@ get_mcu_config ()
   return cfg;
 }
 
+/* LOCAL PATCH: pick the register sequence that belongs to the command being
+ * sent. The sensor latches its capture mode from these bytes, so sending the
+ * fdt_mode sequence for an up/down switch silently leaves it unable to produce
+ * a frame. */
+static GoodixTls5xxMcuConfig
+get_mcu_config_for_mode (FpDevice *dev,
+                         void (*mode_switch)(FpDevice *, const guint8 *, guint16,
+                                             GDestroyNotify,
+                                             GoodixDefaultCallback, gpointer))
+{
+  GoodixTls5xxMcuConfig cfg;
+
+  cfg.free_fn = NULL;
+
+  if (mode_switch == goodix_send_mcu_switch_to_fdt_up)
+    {
+      cfg.data = fdt_up_mode;
+      cfg.data_len = sizeof (fdt_up_mode);
+    }
+  else if (mode_switch == goodix_send_mcu_switch_to_fdt_down)
+    {
+      cfg.data = fdt_down_mode;
+      cfg.data_len = sizeof (fdt_down_mode);
+    }
+  else
+    {
+      cfg.data = fdt_switch_state_mode;
+      cfg.data_len = sizeof (fdt_switch_state_mode);
+    }
+
+  return cfg;
+}
+
 static FpImage *
 crop_frame (guint8 * frame)
 {
@@ -302,6 +390,7 @@ fpi_device_goodixtls511_class_init (FpiDeviceGoodixTls511Class * class)
   FpiDeviceGoodixTls5xxClass * xx_cls = FPI_DEVICE_GOODIXTLS5XX_CLASS (class);
 
   xx_cls->get_mcu_cfg = get_mcu_config;
+  xx_cls->get_mcu_cfg_for_mode = get_mcu_config_for_mode;
   xx_cls->process_frame = crop_frame;
   xx_cls->scan_height = GOODIX511_HEIGHT;
   xx_cls->scan_width = GOODIX511_SCAN_WIDTH;
diff --git a/libfprint/drivers/goodixtls/goodix511.h b/libfprint/drivers/goodixtls/goodix511.h
index 758e968..4a3a2b5 100644
--- a/libfprint/drivers/goodixtls/goodix511.h
+++ b/libfprint/drivers/goodixtls/goodix511.h
@@ -20,20 +20,35 @@
 
 #pragma once
 
-#define GOODIX_511_INTERFACE (0)
+/* LOCAL PATCH: this 27c6:5117 unit exposes a split USB layout — interface 0
+ * carries only the IN interrupt endpoint (0x82), while the bulk data pair
+ * (OUT 0x01 / IN 0x81) lives on interface 1. The stock driver assumed a single
+ * interface holding both, so every command was sent to the wrong interface and
+ * timed out ("did not claim interface 1 before use"). */
+#define GOODIX_511_INTERFACE (1)
 #define GOODIX_511_EP_IN (0x1 | FPI_USB_ENDPOINT_IN)
 #define GOODIX_511_EP_OUT (0x1 | FPI_USB_ENDPOINT_OUT)
 
 #define GOODIX_511_FIRMWARE_VERSION ("GF_ST411SEC_APP_12109")
+/* LOCAL PATCH: accept the whole GF_ST411SEC_APP_ 511 family (e.g. 12118)
+ * instead of only the 12109 build this driver was developed against. */
+#define GOODIX_511_FIRMWARE_PREFIX ("GF_ST411SEC_APP_")
 
 #define GOODIX_511_PSK_FLAGS (0xbb020003)
 
 #define GOODIX_511_RESET_NUMBER (2048)
 
+/* Factory value reported by PRESET_PSK_READ. It is a digest of the
+ * white-box blob the Windows driver stored, not the TLS key. A sensor
+ * that has been re-provisioned by Windows reports something else, so the
+ * comparison in goodixtls5xx_check_preset_psk_read() is a warning only.
+ *
+ * The TLS key itself lives in /etc/goodix5117/psk when the sensor has a
+ * per-device key; it is all zeroes for a factory-provisioned sensor. */
 const guint8 goodix_511_psk_0[] = {
-  0xba, 0x1a, 0x86, 0x03, 0x7c, 0x1d, 0x3c, 0x71, 0xc3, 0xaf, 0x34,
-  0x49, 0x55, 0xbd, 0x69, 0xa9, 0xa9, 0x86, 0x1d, 0x9e, 0x91, 0x1f,
-  0xa2, 0x49, 0x85, 0xb6, 0x77, 0xe8, 0xdb, 0xd7, 0x2d, 0x43};
+  0xba, 0x1a, 0x86, 0x03, 0x7c, 0x1d, 0x3c, 0x71, 0xc3, 0xaf, 0x34, 0x49,
+  0x55, 0xbd, 0x69, 0xa9, 0xa9, 0x86, 0x1d, 0x9e, 0x91, 0x1f, 0xa2, 0x49,
+  0x85, 0xb6, 0x77, 0xe8, 0xdb, 0xd7, 0x2d, 0x43};
 
 guint8 goodix_511_config[] = {
   0x70, 0x11, 0x60, 0x71, 0x2c, 0x9d, 0x2c, 0xc9, 0x1c, 0xe5, 0x18, 0xfd,
diff --git a/libfprint/drivers/goodixtls/goodix5xx.c b/libfprint/drivers/goodixtls/goodix5xx.c
index a75d28b..1854872 100644
--- a/libfprint/drivers/goodixtls/goodix5xx.c
+++ b/libfprint/drivers/goodixtls/goodix5xx.c
@@ -65,6 +65,11 @@ send_switch_mode (FpDevice * dev, gpointer ssm, void (*mode_switch)(FpDevice *,
   FpiDeviceGoodixTls5xxClass *cls = FPI_DEVICE_GOODIXTLS5XX_GET_CLASS (dev);
   GoodixTls5xxMcuConfig cfg = cls->get_mcu_cfg ();
 
+  /* LOCAL PATCH: some parts need a distinct register sequence per FDT command
+   * (up / down / mode) rather than one shared table. Optional class hook. */
+  if (cls->get_mcu_cfg_for_mode)
+    cfg = cls->get_mcu_cfg_for_mode (FP_DEVICE (dev), mode_switch);
+
   mode_switch (dev, cfg.data, cfg.data_len, cfg.free_fn, goodixtls5xx_check_none_cmd, ssm);
 }
 static void on_calibrate_scan(FpDevice* dev, guint8* data, guint16 len, gpointer ssm, GError* err) {
@@ -139,10 +144,26 @@ goodixtls5xx_check_firmware_version (FpDevice *dev, gchar *firmware,
 
   if (strcmp (firmware, cls->firmware_version))
     {
-      g_set_error (&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                   "Invalid device firmware: \"%s\"", firmware);
-      fpi_ssm_mark_failed (user_data, error);
-      return;
+      /* LOCAL PATCH: some units ship a different build of the same firmware
+       * family (e.g. GF_ST411SEC_APP_12118 instead of _12109). Accept any
+       * build sharing the family prefix before the trailing version number,
+       * but warn so mismatches remain visible in the logs. */
+      const char *sep = strrchr (cls->firmware_version, '_');
+      size_t prefix_len = sep ? (size_t) (sep - cls->firmware_version + 1) : 0;
+
+      if (prefix_len > 0 && !strncmp (firmware, cls->firmware_version, prefix_len))
+        {
+          fp_warn ("Firmware \"%s\" differs from the expected \"%s\"; "
+                   "continuing with the same firmware family.",
+                   firmware, cls->firmware_version);
+        }
+      else
+        {
+          g_set_error (&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                       "Invalid device firmware: \"%s\"", firmware);
+          fpi_ssm_mark_failed (user_data, error);
+          return;
+        }
     }
 
   fpi_ssm_next_state (user_data);
@@ -193,10 +214,12 @@ goodixtls5xx_check_preset_psk_read (FpDevice *dev, gboolean success,
 
   if (memcmp (psk, cls->psk, cls->psk_len))
     {
-      g_set_error (&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                   "Invalid device PSK: 0x%s", psk_str);
-      fpi_ssm_mark_failed (user_data, error);
-      return;
+      /* The sensor reports the digest of the white-box blob the Windows
+       * driver wrote, which is different for every device and changes
+       * whenever Windows re-provisions it. It is not the TLS key, so a
+       * mismatch must not stop the activation: the real key is checked
+       * during the handshake. */
+      fp_warn ("Device PSK differs from the factory value: 0x%s", psk_str);
     }
 
   fpi_ssm_next_state (user_data);
@@ -334,14 +357,74 @@ scan_on_read_img (FpDevice *dev, guint8 *data, guint16 len,
   GoodixTls5xxPix * raw_frame = calloc (cls->scan_width * cls->scan_height, sizeof (GoodixTls5xxPix));
   goodixtls5xx_decode_frame (raw_frame, len, data);
   linear_subtract_inplace(raw_frame, priv->calibration_img, cls->scan_width * cls->scan_height);
+
+  /* Debug helper: the dynamic range of the background-subtracted frame shows
+   * whether the subtraction actually worked. A small span means the
+   * calibration frame no longer describes the current sensor state (e.g.
+   * temperature drift between activation and scan), which flattens the
+   * ridges and makes the minutiae extraction fail completely. */
+  {
+    const guint n = cls->scan_width * cls->scan_height;
+    GoodixTls5xxPix rmin = 0xffff, rmax = 0;
+    for (guint i = 0; i < n; i++)
+      {
+        if (raw_frame[i] < rmin) rmin = raw_frame[i];
+        if (raw_frame[i] > rmax) rmax = raw_frame[i];
+      }
+    fp_dbg ("residual range after calibration: %u..%u (span %u)", rmin, rmax, rmax - rmin);
+  }
+
   guint8 * squashed = calloc (cls->scan_height * cls->scan_width, 1);
   goodixtls5xx_squash_frame_linear (raw_frame, squashed, cls->scan_height * cls->scan_width);
   free (raw_frame);
   FpImage * img = cls->process_frame (squashed);
   free(squashed);
 
+  /* Debug helper: dump the frame the matcher actually sees, so that frames
+   * captured with a good and with a bad finger placement can be compared.
+   * Set GOODIX_DUMP_DIR=/some/dir to enable it. */
+  {
+    const char *dump_dir = g_getenv ("GOODIX_DUMP_DIR");
+    if (dump_dir)
+      {
+        gint64 ts;
+        char *path;
+
+        ts = g_get_real_time ();
+        path = g_strdup_printf ("%s/goodix-%" G_GINT64_FORMAT ".pgm", dump_dir, ts);
+        if (goodixtls5xx_save_image_to_pgm (img, path))
+          fp_dbg ("dumped image to %s", path);
+        else
+          g_warning ("failed to dump image to %s", path);
+        g_free (path);
+      }
+  }
+
   fpi_image_device_image_captured (img_dev, img);
 
+  if (fpi_device_get_current_action (dev) != FPI_DEVICE_ACTION_ENROLL)
+    {
+      /* The core only deactivates the device - and therefore only completes
+       * the action - once we report finger-off, see
+       * fpi_image_device_report_finger_status().
+       *
+       * Waiting for the FTD_UP command here does not work: that command only
+       * completes once the finger is physically lifted, so the action stays
+       * pending until fprintd cancels it, and a successful match ends up
+       * reported as "verify-no-match" (the "Idle cancelling on ongoing
+       * operation!" path in fp-device.c).
+       *
+       * Upstream image drivers report finger-off right after the capture as
+       * well, see aes3k.c, egis0570.c and upektc_img.c.
+       *
+       * Stop the state machine first so that we do not issue any further
+       * commands to the device; the deactivation below resets it anyway.
+       */
+      fpi_ssm_mark_completed (ssm);
+      fpi_image_device_report_finger_status (img_dev, FALSE);
+      return;
+    }
+
   fpi_ssm_next_state (ssm);
 }
 
@@ -408,6 +491,13 @@ scan_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
   if (error)
     {
       fp_err ("failed to scan: %s (code: %d)", error->message, error->code);
+
+      /* If the action is already gone there is nothing left to report; the
+       * device was deactivated on purpose (e.g. after a successful capture)
+       * and reporting an error now would only produce a bogus warning. */
+      if (fpi_device_get_current_action (dev) == FPI_DEVICE_ACTION_NONE)
+        return;
+
       fpi_image_device_session_error (FP_IMAGE_DEVICE (dev), error);
       return;
     }
